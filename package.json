{
  "name": "apex-mechanics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "esbuild tools/simtest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/simtest.mjs --log-level=error && node node_modules/.cache/simtest.mjs && npm run test:skills",
    "test:skills": "esbuild tools/testcheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/testcheck.mjs --log-level=error && node node_modules/.cache/testcheck.mjs",
    "test:drill": "esbuild tools/debugrun.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/debugrun.mjs --log-level=error && node node_modules/.cache/debugrun.mjs",
    "build:single": "npm run build && node tools/bundle-single.mjs dist/apex-single.html"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
